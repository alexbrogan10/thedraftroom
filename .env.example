# Copy this file to .env and adjust as needed.

# --- Database ---
POSTGRES_USER=draftroom
POSTGRES_PASSWORD=draftroom
POSTGRES_DB=draftroom
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://draftroom:draftroom@db:5432/draftroom

# --- Backend (FastAPI) ---
APP_NAME="The Draft Room API"
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CURRENT_DRAFT_YEAR=2026

# --- Draft Grade component weights (must be non-negative; auto-normalized to sum to 1.0) ---
DRAFT_GRADE_PRODUCTION=0.25
DRAFT_GRADE_ATHLETIC_PROFILE=0.15
DRAFT_GRADE_AGE_EXPERIENCE=0.10
DRAFT_GRADE_POSITION_VALUE=0.15
DRAFT_GRADE_NFL_PROJECTION=0.25
DRAFT_GRADE_RISK_ADJUSTMENT=0.10

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
